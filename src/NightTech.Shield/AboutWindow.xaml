<Window x:Class="NightTech.Shield.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Night Tech Shield" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="White">
  <StackPanel>
    <Border Background="{StaticResource Navy}" Padding="20,16">
      <DockPanel>
        <Image Source="Assets/shield-256.png" Width="56" Height="56" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Night Tech Shield" Foreground="White" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="VersionText" Foreground="#CBD5E0" FontSize="13" />
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Margin="20,16">
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
        Free from Night Tech Solutions, a family-owned computer repair and IT support business in the Upstate of South Carolina.
        Shield uses Microsoft Defender, which is built into Windows, and adds Night Tech's own checks for adware, browser hijacks and other changes antivirus often leaves alone.
      </TextBlock>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource Muted}" FontSize="13">
        Shield reports what it sees when it scans. It can't promise a PC is free of every kind of malware.
        Nothing about your PC is sent anywhere: Shield has no accounts, ads or tracking.
      </TextBlock>
      <TextBlock Margin="0,0,0,4">
        <Run Text="Call " /><Hyperlink Style="{StaticResource LinkText}" Click="Phone_Click"><Run x:Name="PhoneRun" /></Hyperlink><Run Text=" or text " /><Run x:Name="TextRun" />
      </TextBlock>
      <TextBlock x:Name="HoursText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap" />
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
        <Hyperlink Style="{StaticResource LinkText}" Click="Website_Click">nighttech.solutions</Hyperlink><Run Text="  ·  " />
        <Hyperlink Style="{StaticResource LinkText}" Click="Help_Click">Shield help</Hyperlink><Run Text="  ·  " />
        <Hyperlink Style="{StaticResource LinkText}" Click="FreeApps_Click">More free apps</Hyperlink><Run Text="  ·  " />
        <Hyperlink Style="{StaticResource LinkText}" Click="Privacy_Click">Privacy</Hyperlink><Run Text="  ·  " />
        <Hyperlink Style="{StaticResource LinkText}" Click="Updates_Click">Check for updates</Hyperlink><Run Text="  ·  " />
        <Hyperlink Style="{StaticResource LinkText}" Click="Source_Click">Source code (MIT license)</Hyperlink>
      </TextBlock>
      <TextBlock x:Name="VerseText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
      <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14">
        Microsoft Defender and Windows are trademarks of Microsoft. Night Tech Solutions isn't affiliated with Microsoft.
      </TextBlock>
      <Button Content="Close" Style="{StaticResource Secondary}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>
